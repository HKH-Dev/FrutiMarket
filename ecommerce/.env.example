# Copie este archivo como .env (en esta misma carpeta, ecommerce/) y cambie los valores.
# .env NO se sube a git: cada integrante tiene el suyo con sus propias contrasenas.
# Sin espacios alrededor del "=" ni comillas.

# --- Usuario de la base de datos (H2 ahora, MariaDB mas adelante) ---
# Con H2 este usuario se crea solo al arrancar la aplicacion y es el que usa en la consola
# http://localhost:8080/h2-console. Todo el equipo usa el mismo nombre; cada uno su contrasena.
DB_USER=ecommerce_app
DB_PASSWORD=Pass@123/
DB_NAME=ecommercedb

# --- Solo para MariaDB (perfil "mariadb"); con H2 se ignoran ---
DB_HOST=localhost
# 3307 si usa el contenedor de docker-compose.yml; 3306 si instalo MariaDB directamente.
DB_PORT=3307
# Solo lo usa docker compose para el administrador del contenedor. La aplicacion nunca usa root.
DB_ROOT_PASSWORD=cambia_esta_clave_root
