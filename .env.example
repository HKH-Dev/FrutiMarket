# Copie este archivo como .env (en la raiz del repositorio) y cambie todos los valores.
# .env no se sube a git.
DB_NAME=ecommercedb
DB_USER=ecommerce_app
DB_PASSWORD=cambie-esta-clave
DB_ROOT_PASSWORD=cambie-esta-otra-clave
# Minimo 32 caracteres. Se puede generar con: openssl rand -base64 48
JWT_SECRET=cambie-esta-clave-por-una-de-al-menos-32-caracteres
ADMIN_CLAVE=cambie-admin
CAMPESINO_CLAVE=cambie-campesino
COMPRADOR_CLAVE=cambie-comprador
# Puerto del equipo y direccion publica exacta (sin / final). El chat rechaza cualquier otro origen.
PUERTO_WEB=8088
ORIGEN_PUBLICO=http://localhost:8088
